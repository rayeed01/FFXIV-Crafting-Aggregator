# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored; this template is committed. Never put a real secret in here.
#
# Both halves of the project read it:
#   - Docker Compose picks it up automatically, being in the same directory as the compose file.
#   - The backend imports it via spring.config.import in application.properties, so nothing needs
#     exporting first. Real environment variables still take precedence, which is what a
#     deployment supplies instead of this file.
#
# Every value below is what you want for local development. The notes call out the ones that
# have to change when this is deployed.

# ---- Postgres ----
# Required. The backend will not start without these two.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

POSTGRES_DB=craft

# Where the backend looks for Postgres. Stays localhost when the database is the compose
# container; a managed database means its hostname goes here.
POSTGRES_HOST=localhost

# The port published on the host, which is what the backend connects to. Containers on the
# craft network reach Postgres as db:5432 regardless of this value.
POSTGRES_PORT=5433

# TLS for the database connection. "disable" is fine against a local container, but a managed
# Postgres almost always requires "require" - the connection is refused otherwise.
POSTGRES_SSL_MODE=disable

# ---- JWT ----
# Required. HS256 needs at least 256 bits of key material - generate one with:
#
#   openssl rand -base64 64
#
# Anyone holding this key can forge a token for any user, including an admin, so it must never
# be committed and should differ between environments.
JWT_SECRET=generate-me-see-comment-above

# Token lifetime in milliseconds. Default is 24 hours.
JWT_EXPIRATION=86400000

# ---- Redis ----
# Caches market prices. The app still runs if Redis is down - lookups just fall through to
# Universalis every time, which is slower and heavier on their API.
REDIS_HOST=localhost
REDIS_PORT=6379

# Empty for the local container, which has no auth. A hosted Redis will issue one, and leaving
# this blank against it fails at startup rather than degrading quietly.
REDIS_PASSWORD=

# ---- CORS ----
# Comma-separated, no spaces. Which frontend origins the browser will let call this API.
# The default covers local Vite (5173) and Next (3000).
#
# A deployed frontend must be added here or every request from it is blocked. Use the exact
# origin - scheme and host, no trailing slash - e.g.
#   CORS_ALLOWED_ORIGINS=https://craftwise.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- External APIs ----
# No credentials needed, both are public. Listed so a different environment can point at a
# mirror or a stub without a rebuild.
XIVAPI_BASE_URL=https://v2.xivapi.com
UNIVERSALIS_BASE_URL=https://universalis.app

# ---- Frontend ----
# The frontend does NOT read this file. Vite only picks up VITE_-prefixed variables, and only
# from the frontend directory - so its configuration belongs in frontend/.env.local:
#
#   VITE_API_BASE_URL=https://your-api-host
#
# Leave it unset locally: the dev server proxies /api to the backend, which keeps requests
# same-origin and sidesteps CORS entirely.
#
# Vercel Analytics and Speed Insights need no configuration. They are injected automatically
# when the app is deployed on Vercel, and are inert anywhere else.
