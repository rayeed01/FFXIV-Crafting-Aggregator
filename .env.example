# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored; this template is committed. Never put a real secret in here.
#
# Both halves of the project read it:
#   - Docker Compose picks it up automatically, being in the same directory as the compose file.
#   - The backend imports it via spring.config.import in application.properties, so nothing needs
#     exporting first. Real environment variables still take precedence, which is what a
#     deployment supplies instead of this file.

# ---- Postgres ----
# Required. The backend will not start without these two.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

POSTGRES_DB=craft

# The port published on the host, which is what the backend connects to. Containers on the
# craft network reach Postgres as db:5432 regardless of this value.
POSTGRES_PORT=5433

# ---- JWT ----
# Required. HS256 needs at least 256 bits of key material - generate one with:
#
#   openssl rand -base64 64
#
# Anyone holding this key can forge a token for any user, including an admin, so it must never
# be committed and should differ between environments.
JWT_SECRET=generate-me-see-comment-above

# Token lifetime in milliseconds. Default is 24 hours.
JWT_EXPIRATION=86400000

# ---- Redis ----
# Caches market prices. The app still runs if Redis is down - lookups just fall through to
# Universalis every time, which is slower and heavier on their API.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- External APIs ----
# No credentials needed, both are public. Listed so a different environment can point at a
# mirror or a stub without a rebuild.
XIVAPI_BASE_URL=https://v2.xivapi.com
UNIVERSALIS_BASE_URL=https://universalis.app
